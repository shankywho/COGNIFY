# Cognify Environment Configuration Example
# Copy this file to server/.env and adjust values for your local environment.

# Server Settings
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Process Role Splitting (all = API + Workers, api = HTTP/Socket only, worker = BullMQ consumers only)
SERVICE_ROLE=all

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cognify"
DIRECT_URL="postgresql://postgres:password@localhost:5432/cognify"

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_string
# 32-byte hex string (64 characters) for AES-256-GCM envelope vault encryption
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis (Queue Workers, Sliding-Window Rate Limiting, Pub/Sub & Caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional: REDIS_URL overrides REDIS_HOST / REDIS_PORT when present
REDIS_URL=

# Queue-Depth Backpressure (Load shedding threshold for workflow-exec queue)
MAX_QUEUE_DEPTH=1000

# AI Providers & Model Routing
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MESH_API_KEY=your_mesh_api_key_here

# Cloud Storage (AWS S3 - Optional, falls back to local storage if omitted)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=cognify-uploads

# Stripe Payments (Global Subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Razorpay Payments (India UPI / Netbanking / Cards)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Monitoring & Error Telemetry (Optional)
SENTRY_DSN=

# Integrations (Optional)
SLACK_BOT_TOKEN=xoxb-...
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
NOTION_API_KEY=secret_...
